# Copia este archivo como `.env` y reemplaza los valores por los de tu cluster.
#
#   cp .env.example .env
#
# La URL sale de MongoDB Atlas: tu cluster → Connect → Drivers.
# Acuérdate de agregar el nombre de la base al final de la ruta: /mundial
#
# El `.env` está en el .gitignore y NO se sube al repositorio.

MONGODB_URI="mongodb+srv://usuario:contraseña@cluster.mongodb.net/mundial?retryWrites=true&w=majority"
